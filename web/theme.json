{
  "version": 2,
  "settings": {
    "color": {
      "palette": [
        {
          "name": "Primary (donkerblauw)",
          "slug": "primary",
          "color": "#073674"
        },
        {
          "name": "Secondary (koper)",
          "slug": "secondary",
          "color": "#CB514A"
        },
        {
          "name": "Blauw",
          "slug": "blue",
          "color": "#124A94"
        },
        {
          "name": "Grijsblauw",
          "slug": "blue-grey",
          "color": "#DBE2E9"
        },
        {
          "name": "Lichtblauw",
          "slug": "blue-light",
          "color": "#D0E4FF"
        },
        {
          "name": "Titel donker",
          "slug": "heading-dark",
          "color": "#2A1E17"
        },
        {
          "name": "Titel licht",
          "slug": "heading-light",
          "color": "#F8F8F8"
        },
        {
          "name": "Tekst",
          "slug": "text",
          "color": "#2A1E17"
        },
        {
          "name": "Tekst licht",
          "slug": "text-light",
          "color": "#FFFFFF"
        }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "'Strichpunkt Sans', sans-serif",
          "slug": "standard-font",
          "name": "Strichpunkt Sans"
        }
      ],
      "fontSizes": [
        {
          "name": "Klein",
          "slug": "small",
          "size": "clamp(0.75rem, calc(0.71rem + 0.19vw), 0.875rem)",
          "lineHeight": "1",
          "fontWeight": 400
        },
        {
          "name": "Normaal",
          "slug": "normal",
          "size": "clamp(1rem, calc(0.96rem + 0.19vw), 1.125rem)",
          "lineHeight": "1.425",
          "fontWeight": 400
        },
        {
          "name": "H4",
          "slug": "h4",
          "size": "clamp(1.25rem, calc(1.1rem + 0.75vw), 1.25rem)",
          "lineHeight": "1.2",
          "fontWeight": 700
        },
        {
          "name": "H3",
          "slug": "h3",
          "size": "clamp(1.5rem, calc(1.2rem + 1.5vw), 1.875rem)",
          "lineHeight": "1.1",
          "fontWeight": 600
        },
        {
          "name": "H2",
          "slug": "h2",
          "size": "clamp(1.75rem, calc(1.3rem + 2.25vw), 2.5rem)",
          "lineHeight": "1.025",
          "fontWeight": 600
        },
        {
          "name": "H1",
          "slug": "h1",
          "size": "clamp(2.25rem, calc(1.5rem + 3.75vw), 3.75rem)",
          "lineHeight": "0.83",
          "fontWeight": 700
        }
      ]
    },
    "spacing": {
      "units": ["px", "em", "rem", "%", "vw"],
      "padding": true,
      "margin": false,
      "blockGap": true,
      "spacingScale": {
        "steps": 0
      },
      "spacingSizes": [
        { "name": "2XS", "slug": "2xs", "size": "clamp(0.5rem, calc(0.46rem + 0.19vw), 0.625rem)" },
        { "name": "XS", "slug": "xs", "size": "clamp(0.75rem, calc(0.66rem + 0.38vw), 1rem)" },
        { "name": "S", "slug": "s", "size": "clamp(1rem, calc(0.85rem + 0.75vw), 1.5rem)" },
        { "name": "M", "slug": "m", "size": "clamp(1.5rem, calc(1.2rem + 1.5vw), 2.5rem)" },
        { "name": "L", "slug": "l", "size": "clamp(2rem, calc(1.4rem + 3vw), 4rem)" },
        { "name": "XL", "slug": "xl", "size": "clamp(3rem, calc(2rem + 5vw), 6rem)" },
        { "name": "2XL", "slug": "2xl", "size": "clamp(4rem, calc(2.5rem + 7.5vw), 9rem)" }
      ]
    },
    "layout": {
      "contentSize": "1400px",
      "wideSize": "1550px",
      "maxwidth": "90%",
      "blockSpacing": "clamp(2rem, calc(1.4rem + 3vw), 4rem)"
    },
    "custom": {
      "radius": {
        "sm": "5px",
        "md": "25px",
        "lg": "40px",
        "pill": "53px"
      },
      "shadow": {
        "card": "3px 3px 7px rgba(0, 0, 0, 0.17)",
        "button": "3px 3px 7px rgba(0, 0, 0, 0.25)"
      },
      "grid": {
        "columns": 12,
        "gutter": "1.5rem"
      }
    }
  },
  "styles": {
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--standard-font)",
      "fontSize": "var(--wp--preset--font-size--normal)",
      "lineHeight": "1.425"
    },
    "color": {
      "text": "var(--wp--preset--color--text)"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--h1)",
          "fontWeight": "700",
          "lineHeight": "0.83"
        },
        "color": { "text": "var(--wp--preset--color--heading-dark)" }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--h2)",
          "fontWeight": "600",
          "lineHeight": "1.025"
        },
        "color": { "text": "var(--wp--preset--color--heading-dark)" }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--h3)",
          "fontWeight": "600",
          "lineHeight": "1.1"
        },
        "color": { "text": "var(--wp--preset--color--heading-dark)" }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--h4)",
          "fontWeight": "700",
          "lineHeight": "1.2"
        },
        "color": { "text": "var(--wp--preset--color--heading-dark)" }
      },
      "h5": {
        "typography": {
          "fontSize": "1.125rem",
          "fontWeight": "700",
          "lineHeight": "1.3"
        },
        "color": { "text": "var(--wp--preset--color--heading-dark)" }
      },
      "h6": {
        "typography": {
          "fontSize": "1rem",
          "fontWeight": "700",
          "lineHeight": "1.4"
        },
        "color": { "text": "var(--wp--preset--color--heading-dark)" }
      },
      "link": {
        "color": {
          "text": "var(--wp--preset--color--blue)"
        }
      }
    }
  }
}